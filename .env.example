# Copy this file to `.env` (already gitignored) in the same directory as
# docker-compose.yml, then fill in real values. Docker Compose loads `.env`
# automatically — nothing else to configure.
#
# Generate a real JWT secret with:  openssl rand -base64 48

DB_PASSWORD=changeme
JWT_SECRET=changeme-generate-a-real-secret-before-any-real-deployment

# Shared token for scan-service /internal/** calls from reward-service. Must be the same in both.
# Generate with:  openssl rand -base64 32   (empty = deposits are refused)
INTERNAL_SERVICE_TOKEN=
